# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
/android/.kotlin/

# OAuth information site build output
/oauth-site/node_modules/
/oauth-site/dist/
/oauth-site/.vercel/

# Local tooling & context
.agent-context/
.impeccable/

# Ignore images & screenshots (do not push images to git)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico

# Keep essential platform launcher icons required to build app
!assets/logo.png
!android/app/src/main/res/**/ic_launcher.png
!ios/Runner/Assets.xcassets/**
!macos/Runner/Assets.xcassets/**
!web/favicon.png
!web/icons/**
!windows/runner/resources/app_icon.ico

# Product template assets are source files and must remain versioned.
!assets/templates/
!assets/templates/**

